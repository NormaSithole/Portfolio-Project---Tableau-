      <column caption='Year Filter ' datatype='boolean' name='[Calculation_1563570544812034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Date - Year] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Chosen Year Profit ' datatype='integer' name='[Calculation_1563570544963587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Date - Year] = [Parameters].[Parameter 1] THEN [Profit] END' />
      </column>
      <column caption='Last Year Profit' datatype='integer' name='[Calculation_1563570545315844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date - Year] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) THEN [Profit]END' />
      </column>
      <column caption='YoY% change ' datatype='real' name='[Calculation_1563570545778693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1563570544963587]) - SUM([Calculation_1563570545315844]))/SUM([Calculation_1563570545315844])' />
